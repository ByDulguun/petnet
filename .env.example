# PetNet environment variables.
# Copy to .env.local for local dev (gitignored) — never commit real values.
# Each block below is marked REQUIRED or OPTIONAL, and which environments
# actually read it. Dev and prod are configured the same way (this app has
# no dev-only/prod-only code paths besides falling back gracefully when an
# OPTIONAL var is unset) — only the values differ per environment.

# ── Database ─────────────────────────────────────────────────────────────────
# REQUIRED — dev + prod. Standard Postgres connection string.
# Local: postgresql://postgres:postgres@localhost:5432/petnet
# Hosted: Neon / Supabase / Railway connection string.
# If your provider gives you a POOLED connection string (e.g. Neon's pooler,
# Supabase's :6543 pgbouncer port) for DATABASE_URL, run `prisma migrate
# deploy` against the DIRECT (unpooled) connection string instead — pooled
# connections can break Prisma's migration locking. Point DATABASE_URL at
# whichever one you actually run the app against day to day.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/petnet"

# ── Auth.js ──────────────────────────────────────────────────────────────────
# AUTH_SECRET — REQUIRED, dev + prod. Signs/encrypts session JWTs. Generate a
# fresh one per environment with: npx auth secret   (or: openssl rand -base64 32)
# Never reuse the same secret across dev and prod, and never commit a real one.
AUTH_SECRET=""

# AUTH_URL — REQUIRED, dev + prod. Must be the exact origin the app is served
# from (protocol + host + port), no trailing slash — e.g.
# "http://localhost:3000" in dev, "https://petnet.mn" in prod. A mismatch
# here (or leaving a stale value from a previous port/domain) breaks
# signOut()'s redirect and other auth redirects silently — the request still
# "succeeds" but the browser gets sent to the wrong origin, so it is easy to
# miss in testing. If you're deploying on a platform that assigns dynamic
# preview URLs (Vercel), set this to your canonical production domain in the
# production environment only — leave preview deployments to fall back to
# Auth.js's platform auto-detection.
AUTH_URL="http://localhost:3000"

# AUTH_TRUST_HOST — REQUIRED in prod on any platform that isn't Vercel or
# Cloudflare Pages (both are auto-detected by Auth.js). If you deploy behind
# any other reverse proxy / Docker / Railway / Fly / Render / a raw VPS,
# unset or "false" here will make Auth.js reject all requests with an
# UntrustedHost error. Not needed for local dev.
AUTH_TRUST_HOST=""

# OAuth providers — OPTIONAL, currently unused. The schema and env slots
# exist for when Google/Facebook sign-in is added; src/lib/auth.ts only
# registers a Credentials (email+password) provider today. Leave blank.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# ── Cloudinary ───────────────────────────────────────────────────────────────
# REQUIRED for image upload (pet photos, business logo/cover) to work — dev +
# prod. Server-only: all uploads go through our own authenticated API routes
# via signed upload_stream calls, never a direct-from-browser unsigned
# upload, so none of these need a NEXT_PUBLIC_ prefix and must never get one.
# Without these set, upload endpoints return a clean 503 rather than
# silently failing — the rest of the app works fine without them.
# Get these from your Cloudinary dashboard (cloudinary.com/console).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Maps ─────────────────────────────────────────────────────────────────────
# OPTIONAL, dev + prod. Client-side key: renders live Google Maps with marker
# clustering on the Map Explorer. Without it, the Map Explorer falls back to
# a schematic projected map — the app still works, just with a less polished
# map. This key IS sent to the browser (that's what NEXT_PUBLIC_ means) — in
# Google Cloud Console, restrict it to the Maps JavaScript API + your site's
# actual HTTP referrers before going to production, so it can't be lifted
# from your page source and used elsewhere on your billing.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ── Geocoding (OpenStreetMap Nominatim) ─────────────────────────────────────
# OPTIONAL, dev + prod — both have sensible defaults, no key or billing
# account needed. NOMINATIM_BASE_URL defaults to the public
# https://nominatim.openstreetmap.org instance. NOMINATIM_USER_AGENT
# defaults to a generic app string. Nominatim's usage policy caps
# unauthenticated use at 1 request/second (enforced server-side in
# src/lib/geocoding.ts, so this is a hard app-level limit, not just a
# suggestion) and asks for a descriptive User-Agent identifying the app —
# set NOMINATIM_USER_AGENT to something with your own contact info (e.g. an
# email or site URL) before relying on the public instance in production;
# Nominatim can and does block generic/unidentified User-Agents under load.
# Switch NOMINATIM_BASE_URL to a self-hosted or paid Nominatim instance if
# you outgrow the public one's rate limit.
NOMINATIM_BASE_URL=""
NOMINATIM_USER_AGENT=""
